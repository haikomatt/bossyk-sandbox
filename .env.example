FIREWORKS_API_KEY=
# kimi-k2p6 — different model family from the deepseek-based judge path
# elsewhere in this codebase, deliberately: using the same family for the
# agent-under-test and its judge/evaluator would violate the same-family
# self-evaluation independence this project is built against. Swap to try a
# different Fireworks-hosted model (see build_airline_agent_session in
# src/bossyk_sandbox/runtime/langgraph_agent.py). Check what your account
# actually has access to: curl https://api.fireworks.ai/inference/v1/models
# -H "Authorization: Bearer $FIREWORKS_API_KEY" | jq '.data[] | select(.supports_tools)'
FIREWORKS_MODEL=accounts/fireworks/models/kimi-k2p6
